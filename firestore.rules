rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPost(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 500
        && data.category is string && data.category.size() <= 120
        && data.content is string && data.content.size() <= 200000
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 10000));
    }

    function isValidComment(data, postId) {
      return data.postId == postId
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 5000;
    }

    // Posts Collection: Public readers can view published posts
    match /posts/{postId} {
      allow get, list: if true;

      // Create: Allow publishing valid posts
      allow create: if isValidId(postId) && isValidPost(request.resource.data);

      // Update: Edit post or increment views/likes
      allow update: if isValidId(postId) && (
        isValidPost(request.resource.data) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewsCount', 'likesCount']) &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.content == resource.data.content
        )
      );

      // Delete: Post by ID
      allow delete: if isValidId(postId);

      // Comments Sub-collection
      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if isValidId(commentId) && isValidComment(request.resource.data, postId);
        allow update, delete: if true;
      }
    }

    // Settings Collection
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if true;
    }

    // System State (Automation & Robot Sync)
    match /system_state/{stateId} {
      allow get, list: if true;
      allow write: if true;
    }

    // Health / Connection Test
    match /test/{testId} {
      allow get, list, write: if true;
    }
  }
}
