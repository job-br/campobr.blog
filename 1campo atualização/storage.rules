rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imagens das matérias: leitura pública; escrita SOMENTE pelo robô (Admin SDK ignora estas regras)
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
